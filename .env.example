# Copy to .env and adjust. .env is git-ignored.

# Host folder holding your WARC files. Drop .warc/.warc.gz files here, then
# run: docker compose exec solrwayback index
SW_WARC_DIR=./warcs

# Host ports. The container always listens on 8080 and 8983 internally.
SW_HTTP_PORT=8090
SW_SOLR_PORT=8990

# Solr heap. Keep well below the memory allotted to Docker Desktop: each
# indexer thread additionally forks a JVM with a 1g heap.
SW_HEAP=3g

# Parallel indexer processes.
INDEX_THREADS=2

# Upstream bundle release to build from.
SW_VERSION=5.4.3
